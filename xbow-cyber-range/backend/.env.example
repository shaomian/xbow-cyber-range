# ===== XBow CyberRange 后端配置 =====
# 所有变量前缀为 XBOW_CYBER_RANGE_，留空则使用默认值

# 基础
XBOW_CYBER_RANGE_SECRET_KEY=change-me-to-a-long-random-string
XBOW_CYBER_RANGE_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库（默认 SQLite 零配置；如需 MySQL 改为下面注释的示例）
XBOW_CYBER_RANGE_DATABASE_URL=sqlite:///./xbow_cyber_range.db
# XBOW_CYBER_RANGE_DATABASE_URL=mysql+aiomysql://user:pass@127.0.0.1:3306/xbow_cyber_range

# Docker 连接（留空则按平台自动选择：Windows=npipe, Linux/Mac=unix socket）
# Linux:   unix:///var/run/docker.sock
# Windows: npipe:////./pipe/docker_engine
# 远程:    tcp://192.168.1.10:2375
XBOW_CYBER_RANGE_DOCKER_HOST=

# 容器加入的网络（空则用默认 bridge）
XBOW_CYBER_RANGE_DOCKER_NETWORK=

# 对外访问地址（不含端口）；远程 agent/用户需用该地址访问实例端口。
# 容器端口实际绑定到 0.0.0.0，本地用 127.0.0.1 即可；远程访问设为公网 IP 或域名。
# 留空时回退 127.0.0.1（仅本地可访问）。
# 例： XBOW_CYBER_RANGE_PUBLIC_HOST=123.456.78.9   或   cyberrange.example.com
XBOW_CYBER_RANGE_PUBLIC_HOST=

# 端口随机范围（首次启动的默认值，管理员可在「系统设置」页在线修改）
XBOW_CYBER_RANGE_PORT_RANGE_START=20000
XBOW_CYBER_RANGE_PORT_RANGE_END=30000

# 实例超时（秒）：到点自动停止
XBOW_CYBER_RANGE_DEFAULT_INSTANCE_TIMEOUT=3600
XBOW_CYBER_RANGE_MAX_INSTANCE_TIMEOUT=28800

# 后台扫描过期实例的间隔
XBOW_CYBER_RANGE_REAPER_INTERVAL_SECONDS=15

# 终端默认命令
XBOW_CYBER_RANGE_TERMINAL_DEFAULT_COMMAND=/bin/sh

# CORS（逗号分隔）
XBOW_CYBER_RANGE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== MCP Server（供 agent 工具调用容器生命周期）=====
# agent 调用 MCP 工具时所 impersonate 的平台用户名（须为管理员）；留空则自动取首个管理员
XBOW_CYBER_RANGE_MCP_ADMIN_USERNAME=
# 挂载到 FastAPI 的 MCP HTTP/SSE 端点路径前缀；置空则不挂载，仅以独立 stdio 进程运行
XBOW_CYBER_RANGE_MCP_HTTP_PATH=/mcp
# MCP HTTP 端点鉴权 Bearer Token；agent 客户端需携带 Authorization: Bearer <此值>。留空则不鉴权
XBOW_CYBER_RANGE_MCP_HTTP_TOKEN=
# stdio 模式下日志文件路径（协议占用 stdout，日志须落盘）；留空则用 backend/.compose-work/mcp.log
XBOW_CYBER_RANGE_MCP_STDIO_LOG_FILE=